<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="36dp"
        android:paddingBottom="48dp"
        android:paddingLeft="18dp"
        android:paddingRight="18dp">

        <!-- App Header with Voice & Unit Toggles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ТЕРМОМЕТР"
                android:textColor="@color/text_title"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <!-- Voice Mute Toggle -->
            <ImageButton
                android:id="@+id/btnVoiceMute"
                android:layout_width="28dp"
                android:layout_height="24dp"
                android:background="@drawable/tab_unselected_bg"
                android:src="@drawable/ic_volume_up"
                android:padding="3dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="Голос" />

            <!-- Unit switch: °C / °F -->
            <Button
                android:id="@+id/btnUnitToggle"
                android:layout_width="38dp"
                android:layout_height="24dp"
                android:background="@drawable/tab_unselected_bg"
                android:text="°C"
                android:textColor="@color/cyan_temp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:padding="0dp" />
        </LinearLayout>

        <!-- Overheat Warning Banner (Visible only if Battery > 42°C) -->
        <LinearLayout
            android:id="@+id/layoutOverheat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/alert_banner_bg"
            android:padding="8dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvOverheatMsg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚠️ Перегрев часов! Снимите с зарядки"
                android:textColor="#FF5252"
                android:textSize="10sp"
                android:textStyle="bold"
                android:gravity="center" />
        </LinearLayout>

        <!-- 3-Mode Selector: Рука / Висок / Воздух -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:background="@drawable/btn_secondary_bg"
            android:padding="2dp"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnTabWrist"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/tab_selected_bg"
                android:text="👤 РУКА"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:padding="0dp" />

            <Button
                android:id="@+id/btnTabTemple"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:text="🎯 ВИСОК"
                android:textColor="@color/text_title"
                android:textSize="9sp"
                android:textStyle="bold"
                android:padding="0dp" />

            <Button
                android:id="@+id/btnTabRoom"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:text="🏠 ВОЗДУХ"
                android:textColor="@color/text_title"
                android:textSize="9sp"
                android:textStyle="bold"
                android:padding="0dp" />
        </LinearLayout>

        <!-- ==================== WRIST MODE CONTAINER ==================== -->
        <LinearLayout
            android:id="@+id/layoutWristMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero Card: Skin Temp & 30s Measure -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ТЕМПЕРАТУРА КОЖИ"
                    android:textColor="@color/orange_temp"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvSkinTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--.- °C"
                    android:textColor="@color/text_white"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSkinStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Датчик запястья"
                    android:textColor="@color/text_title"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="8dp" />

                <!-- Idle mode: Start Measurement Button -->
                <Button
                    android:id="@+id/btnStartMeasure"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:background="@drawable/btn_measure_bg"
                    android:text="⏱️ НАЧАТЬ ЗАМЕР (30 сек)"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textAllCaps="false" />

                <!-- Active Measuring Mode -->
                <LinearLayout
                    android:id="@+id/layoutMeasuring"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvMeasureCountdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30 сек"
                        android:textColor="@color/accent_orange"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <ProgressBar
                        android:id="@+id/pbMeasure"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:progressDrawable="@drawable/progress_measure_drawable"
                        android:max="30"
                        android:progress="30"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvMeasureTip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Прижмите часы плотно к руке..."
                        android:textColor="@color/text_title"
                        android:textSize="9sp"
                        android:layout_marginBottom="8dp" />

                    <Button
                        android:id="@+id/btnCancelMeasure"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:background="@drawable/btn_secondary_bg"
                        android:text="Отмена"
                        android:textColor="@color/text_title"
                        android:textSize="10sp"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:textAllCaps="false" />
                </LinearLayout>

                <!-- Completed Measurement Result -->
                <LinearLayout
                    android:id="@+id/layoutMeasureResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="РЕЗУЛЬТАТ ЗАМЕРА"
                        android:textColor="@color/green_temp"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:layout_marginBottom="2dp" />

                    <!-- Number + Voice Re-Speak Button -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvFixedResult"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="36.6 °C"
                            android:textColor="@color/green_temp"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btnSpeakResult"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/btn_circle_bg"
                            android:src="@drawable/ic_volume_up"
                            android:layout_marginStart="8dp"
                            android:padding="4dp"
                            android:contentDescription="Озвучить" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvResultBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/badge_bg"
                        android:text="✓ В норме"
                        android:textColor="@color/green_temp"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp" />

                    <Button
                        android:id="@+id/btnRepeatMeasure"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:background="@drawable/btn_secondary_bg"
                        android:text="Повторить замер"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:textAllCaps="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- Trend Chart & Stats Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ДИНАМИКА ЗАМЕРА"
                    android:textColor="@color/orange_temp"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="6dp" />

                <!-- Custom Sparkline Live Chart -->
                <com.kaiserdev.watchthermometer.SparklineView
                    android:id="@+id/sparklineView"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="8dp" />

                <!-- Stats Row: Min | Avg | Max -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="МИН"
                            android:textColor="@color/text_title"
                            android:textSize="8sp" />

                        <TextView
                            android:id="@+id/tvStatMin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--.-°"
                            android:textColor="@color/text_white"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="18dp"
                        android:background="#22FFFFFF" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="СРЕДН"
                            android:textColor="@color/text_title"
                            android:textSize="8sp" />

                        <TextView
                            android:id="@+id/tvStatAvg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--.-°"
                            android:textColor="@color/text_white"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="18dp"
                        android:background="#22FFFFFF" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="МАКС"
                            android:textColor="@color/text_title"
                            android:textSize="8sp" />

                        <TextView
                            android:id="@+id/tvStatMax"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--.-°"
                            android:textColor="@color/text_white"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Thermal Comfort Balance Card (Delta T = Skin - Ambient) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ТЕПЛОВОЙ БАЛАНС (ΔT)"
                    android:textColor="@color/cyan_temp"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:id="@+id/tvDeltaT"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+0.0 °C"
                    android:textColor="@color/text_white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvThermalStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌿 Оптимальный тонус сосудов"
                    android:textColor="@color/green_temp"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tvThermalDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Разница температур кожи и воздуха"
                    android:textColor="@color/text_title"
                    android:textSize="8sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ==================== TEMPLE / FOREHEAD MODE CONTAINER ==================== -->
        <LinearLayout
            android:id="@+id/layoutTempleMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card"
                android:paddingTop="12dp"
                android:paddingBottom="14dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎯 ЗАМЕР НА ВИСКЕ / ЛБУ"
                    android:textColor="@color/orange_temp"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvTempleTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--.- °C"
                    android:textColor="@color/text_white"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTempleStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Приложите тыльную сторону к виску"
                    android:textColor="@color/text_title"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnStartTempleMeasure"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:background="@drawable/btn_measure_bg"
                    android:text="⏱️ ЗАМЕР НА ВИСКЕ (15 сек)"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textAllCaps="false" />

                <TextView
                    android:id="@+id/tvTempleCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15 сек... Держите у виска"
                    android:textColor="@color/accent_orange"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp"
                    android:visibility="gone" />

                <!-- Temple Result Layout -->
                <LinearLayout
                    android:id="@+id/layoutTempleResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginTop="6dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvTempleFixedResult"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="36.6 °C"
                        android:textColor="@color/green_temp"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTempleResultBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/badge_bg"
                        android:text="✓ Норма (Височная артерия)"
                        android:textColor="@color/green_temp"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:padding="4dp"
                        android:layout_marginTop="3dp"
                        android:layout_marginBottom="6dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ==================== ROOM / AMBIENT MODE CONTAINER ==================== -->
        <LinearLayout
            android:id="@+id/layoutRoomMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card"
                android:paddingTop="12dp"
                android:paddingBottom="14dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="МИКРОКЛИМАТ ПОМЕЩЕНИЯ"
                    android:textColor="@color/cyan_temp"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvRoomTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--.- °C"
                    android:textColor="@color/text_white"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRoomStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Снимите часы для точного замера"
                    android:textColor="@color/text_title"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnStartRoomMeasure"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:background="@drawable/btn_measure_bg"
                    android:text="⏱️ ЗАМЕРИТЬ ВОЗДУХ (2 мин)"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textAllCaps="false" />

                <TextView
                    android:id="@+id/tvRoomCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Остывание от руки..."
                    android:textColor="@color/cyan_temp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- ==================== HISTORY LOG CARD ==================== -->
        <LinearLayout
            android:id="@+id/layoutHistoryCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ЖУРНАЛ ЗАМЕРОВ"
                    android:textColor="@color/text_title"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <Button
                    android:id="@+id/btnClearHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:background="@null"
                    android:text="Очистить"
                    android:textColor="#88FFFFFF"
                    android:textSize="8sp"
                    android:padding="0dp" />
            </LinearLayout>

            <!-- Dynamic list of entries -->
            <LinearLayout
                android:id="@+id/layoutHistoryList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHistoryEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="История пуста. Сделайте первый замер."
                    android:textColor="#55FFFFFF"
                    android:textSize="9sp"
                    android:gravity="center"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Hardware Sensors Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_card"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ДАТЧИКИ ПЛАТЫ И БАТАРЕИ"
                android:textColor="@color/cyan_temp"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="БАРОМЕТР"
                        android:textColor="@color/text_title"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/tvAmbientTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--.- °C"
                        android:textColor="@color/text_white"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:background="#22FFFFFF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="БАТАРЕЯ"
                        android:textColor="@color/text_title"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/tvBatteryTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--.- °C"
                        android:textColor="@color/text_white"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Precision Calibration Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_card"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ТОЧНАЯ КАЛИБРОВКА"
                android:textColor="@color/text_title"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="6dp" />

            <!-- Minus / Value / Plus -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <Button
                    android:id="@+id/btnOffsetMinus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/btn_circle_bg"
                    android:text="-"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:padding="0dp" />

                <TextView
                    android:id="@+id/tvOffsetVal"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="+0.0 °C"
                    android:textColor="@color/text_white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <Button
                    android:id="@+id/btnOffsetPlus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/btn_circle_bg"
                    android:text="+"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:padding="0dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Смещение для подгонки под градусник"
                android:textColor="@color/text_title"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Footnote info -->
        <TextView
            android:id="@+id/tvSensorList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Xiaomi Watch 5 • Wear OS • v2.0.0"
            android:textColor="@color/text_title"
            android:textSize="9sp"
            android:gravity="center" />

    </LinearLayout>
</ScrollView>
